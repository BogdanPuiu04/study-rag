# Retrieval
STUDY_RAG_EMBEDDER=hash          # hash | hf
STUDY_RAG_RERANKER=none          # none | hf
STUDY_RAG_STORE=memory           # memory | pgvector
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Generation
STUDY_RAG_LLM=extractive         # extractive | claude | bedrock
STUDY_RAG_CLAUDE_MODEL=claude-opus-5-5
STUDY_RAG_CLAUDE_EFFORT=medium   # low | medium | high
# ANTHROPIC_API_KEY=             # for STUDY_RAG_LLM=claude
AWS_REGION=us-east-1             # for STUDY_RAG_LLM=bedrock
